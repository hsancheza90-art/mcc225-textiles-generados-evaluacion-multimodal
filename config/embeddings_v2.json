{
  "schema_version": "1.0",
  "artifact_version": "embeddings-v2",
  "dataset_version": "v2",
  "reproducibility": {
    "seed": 225,
    "canonical_device": "cpu",
    "dtype": "float32",
    "torch_num_threads": 8,
    "image_batch_size": 8,
    "text_batch_size": 64
  },
  "model": {
    "library": "open_clip",
    "architecture": "ViT-B-32",
    "pretrained": "laion2b_s34b_b79k",
    "mode": "zero_shot",
    "frozen": true,
    "embedding_dimension": 512,
    "normalization": "l2",
    "similarity": "dot_product_of_normalized_embeddings"
  },
  "inputs": {
    "image_manifest": {
      "path": "data/v2/manifest_imagenes_v2.csv",
      "id_field": "image_id",
      "path_field": "image_path",
      "expected_count": 56
    },
    "text_sources": [
      {
        "source_id": "positivos",
        "path": "data/v2/captions_positivos_v2.csv",
        "record_id_field": "caption_id",
        "text_field": "caption_text",
        "expected_count": 280
      },
      {
        "source_id": "sin_color",
        "path": "data/v2/captions_sin_color_v2.csv",
        "record_id_field": "colorless_caption_id",
        "text_field": "caption_text",
        "expected_count": 40
      },
      {
        "source_id": "negativos_dificiles",
        "path": "data/v2/candidatos_negativos_dificiles_v2.csv",
        "record_id_field": "candidate_id",
        "text_field": "candidate_text",
        "expected_count": 280
      }
    ]
  },
  "deduplication": {
    "method": "exact_unicode_string",
    "text_hash": "sha256_utf8",
    "source_order": [
      "positivos",
      "sin_color",
      "negativos_dificiles"
    ],
    "within_source_order": "csv_row_order",
    "expected_usage_count": 600,
    "expected_unique_text_count": 494
  },
  "image_variants": [
    {
      "variant_id": "original",
      "transform": "openclip_preprocess"
    },
    {
      "variant_id": "grayscale",
      "transform": "pil_convert_L_then_RGB_then_openclip_preprocess"
    }
  ],
  "outputs": {
    "directory": "results/v2/embeddings",
    "image_index_csv": "results/v2/embeddings/index_images_v2.csv",
    "text_index_csv": "results/v2/embeddings/index_textos_unicos_v2.csv",
    "text_usage_csv": "results/v2/embeddings/usos_textos_v2.csv",
    "image_original_npy": "results/v2/embeddings/embeddings_imagen_original_v2.npy",
    "image_grayscale_npy": "results/v2/embeddings/embeddings_imagen_grayscale_v2.npy",
    "text_unique_npy": "results/v2/embeddings/embeddings_textos_unicos_v2.npy",
    "summary_json": "results/v2/embeddings/resumen_embeddings_v2.json"
  },
  "expected_shapes": {
    "image_original": [
      56,
      512
    ],
    "image_grayscale": [
      56,
      512
    ],
    "text_unique": [
      494,
      512
    ],
    "image_index_rows": 56,
    "text_index_rows": 494,
    "text_usage_rows": 600
  },
  "validation": {
    "finite_values_required": true,
    "l2_normalized": true,
    "norm_absolute_tolerance": 1e-05,
    "row_order_is_contractual": true,
    "relative_paths_only": true,
    "utf8_without_bom": true,
    "line_endings": "lf"
  }
}
