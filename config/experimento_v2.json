      "dataset": "v1"
    },
    {
      "experiment_id": "E1",
      "name": "global_retrieval_v2",
      "dataset": "v2"
    },
    {
      "experiment_id": "E2",
      "name": "hard_negative_forced_choice",
      "dataset": "v2"
    },
    {
      "experiment_id": "E3",
      "name": "baseline_comparison",
      "conditions": [
        "openclip",
        "random",
        "color_histogram"
      ]
    },
    {
      "experiment_id": "E4",
      "name": "color_ablations",
      "conditions": [
        "original_image_full_caption",
        "grayscale_image_full_caption",
        "original_image_caption_without_color",
        "grayscale_image_caption_without_color"
      ]
    },
    {
      "experiment_id": "E5",
      "name": "id_ood_comparison",
      "conditions": [
        "id",
        "ood_palette",
        "ood_pattern",
        "ood_both"
      ]
    },
    {
      "experiment_id": "E6",
      "name": "bootstrap_and_stratified_analysis",
      "strata": [
        "pattern_id",
        "ambiguity_level",
        "split",
        "changed_attribute"
      ]
    }
  ],
  "metrics": {
    "primary": [
      "recall_at_1",
      "mrr",
      "ndcg_at_10"
    ],
    "supplementary": [
      "recall_at_5",
      "hard_negative_accuracy",
      "positive_margin",
      "paired_difference"
    ],
    "hard_negative_chance_level": 0.2
  },
  "baselines": [
    {
      "baseline_id": "random",
      "uses_image": false,
      "uses_text": false,
      "seed": 225
    },
    {
      "baseline_id": "color_histogram",
      "uses_image": true,
      "uses_text": true,
      "uses_only_attribute": "palette_id",
      "color_space": "HSV"
    }
  ],
  "prohibited_claims": [
    "cultural_identification",
    "heritage_authentication",
    "geographic_origin_inference",
    "symbolic_interpretation",
    "generalization_to_real_textiles"
  ]
