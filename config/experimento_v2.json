{
  "schema_version": "1.0",
  "protocol_version": "2.0",
  "project": {
    "student": "Henry Sánchez Alvarado",
    "course": "MCC225",
    "title": "Evaluación controlada de OpenCLIP para recuperación imagen-texto con patrones textiles sintéticos",
    "task": "cross_modal_image_to_text_retrieval",
    "scope": "synthetic_geometric_patterns",
    "cultural_identification": false,
    "fine_tuning": false
  },
  "reproducibility": {
    "seed": 225,
    "python_target": "3.11",
    "deterministic_generation": true,
    "relative_paths_only": true,
    "bootstrap_iterations": 2000,
    "confidence_level": 0.95
  },
  "model": {
    "library": "open_clip",
    "architecture": "ViT-B-32",
    "pretrained": "laion2b_s34b_b79k",
    "mode": "zero_shot",
    "frozen": true,
    "embedding_normalization": "l2",
    "similarity": "dot_product_of_normalized_embeddings"
  },
  "dataset_v2": {
